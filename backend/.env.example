# ---- Server ----
PORT=4000
NODE_ENV=development

# Change this to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated allowed origins. Use your Vercel URL in production.
CORS_ORIGINS=http://localhost:5173

# ---- Database (optional) ----
# Leave empty to use the built-in in-memory store (demo mode).
# MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/medchain
MONGODB_URI=

# ---- Blockchain (read-only; the server never holds a private key) ----
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
CONTRACT_ADDRESS=
EXPLORER_BASE=https://sepolia.etherscan.io

# ---- IPFS (optional) ----
# Leave empty to use local content-addressed storage (demo mode).
# Pinata: https://app.pinata.cloud > API Keys > New Key > copy the JWT.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
PUBLIC_IPFS_GATEWAY=https://ipfs.io

MAX_UPLOAD_BYTES=15728640

# ---- Bootstrap admin (created on first boot) ----
ADMIN_EMAIL=admin@bmr.local
ADMIN_PASSWORD=Admin@12345

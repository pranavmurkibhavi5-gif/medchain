# Copy to .env and fill in. NEVER commit .env or a real private key.

# Sepolia RPC. Free options: publicnode, Alchemy, Infura.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of the deployer account (needs Sepolia test ETH).
# Export from MetaMask: Account details > Show private key. NO 0x prefix needed.
DEPLOYER_PRIVATE_KEY=

# Optional: for `npx hardhat verify`
ETHERSCAN_API_KEY=

# Local Ganache RPC (only for local development)
GANACHE_RPC_URL=http://127.0.0.1:7545
